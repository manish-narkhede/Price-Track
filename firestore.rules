rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Products are readable by all authenticated users; writable only by Cloud Functions (admin)
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Price history readable by authenticated users; writable only by backend
    match /priceHistory/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tracked products: users can only read/write their own
    match /trackedProducts/{docId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
